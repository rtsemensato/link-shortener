# Copie para .env e ajuste os valores. Nunca commitar o .env de verdade.

DATABASE_URL="postgresql://linkshortener:linkshortener_dev@localhost:5434/linkshortener?schema=public"

JWT_ACCESS_SECRET=troque-por-uma-chave-aleatoria-longa
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=troque-por-outra-chave-aleatoria-longa
JWT_REFRESH_EXPIRES_IN=30d

# URL base usada para montar o link encurtado nas respostas da API
# (ex: http://localhost:3000/abc123). Em produção, a URL real da API.
BASE_URL=http://localhost:3000

PORT=3000
